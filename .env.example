# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so
# it must never hold a real value.

# --- Kit (formerly ConvertKit) -------------------------------------------------
# The newsletter list, and the reason the download is a gate rather than a reveal:
# the server subscribes the reader itself and only mints a link once that call has
# come back clean. Both values are required. Without them the form tells the reader
# something went wrong and nobody gets a file.
#
# KIT_API_KEY  Kit → your account → Settings → Developer → API keys, and take the
#              v4 API key rather than the older v3 key or secret. Treat it as a
#              secret: it can read and write the whole list. It stays on the
#              server and never reaches the browser.
# KIT_FORM_ID  The number in your form's own URL — app.kit.com/forms/1234567/edit
#              means 1234567. Not the form's uid and not the whole URL; lib/kit.ts
#              refuses both and says so in the log rather than 404ing later.
KIT_API_KEY=
KIT_FORM_ID=

# --- Signed download links ----------------------------------------------------
# Signs the links that app/api/download will honour. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Two things mint links with it: app/actions/subscribe.ts, once per signup Kit
# accepted, and you by hand for a link to paste into an email Kit sends:
#   node scripts/mint-download-link.mjs https://yoursite.com
#
# Without this set the signup half still works and the download half does not —
# the reader ends up on the list with no file — and app/api/download rejects every
# link. Required in production, not optional.
#
# Changing this value invalidates every link already minted, including any sitting
# in an email. That is the revoke switch; mint a new one afterwards.
DOWNLOAD_LINK_SECRET=
